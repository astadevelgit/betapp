# ---------------------------------------------------------------------------
# BetApp local environment
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for Supabase email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key (or the legacy anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the secret key (or the legacy service_role key). Server-only.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Postgres connection strings
# DATABASE_URL: use the transaction pooler (port 6543) for the app.
# DATABASE_URL_DIRECT: use the direct connection (port 5432) for drizzle-kit.
DATABASE_URL=
DATABASE_URL_DIRECT=

# One-time admin bootstrap (npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=BetApp Admin
ADMIN_DOB=1990-01-01

# Football data provider. Leave blank for automatic priority:
# sportmonks -> api-football -> the-odds-api.
# Set explicitly to avoid surprises when more than one provider key is present.
# Valid values: sportmonks, api-football, the-odds-api
FOOTBALL_PROVIDER=

# Sportmonks (preferred football data provider)
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
# Comma-separated league IDs. The free plan currently exposes 271 (Denmark)
# and 501 (Scotland). A paid plan is required for wider production coverage.
SPORTMONKS_LEAGUE_IDS=271,501
# Maximum fixtures to refresh odds for per 10-minute run. Keep this at 8 on
# the 180 requests/hour free plan. With The Odds API, raise it (for example to
# 40) to cover a full slate: its bulk odds response is shared, so the credit
# cost does not grow with the fixture count.
ODDS_SYNC_MAX_FIXTURES=8

# Legacy API-Football fallback. Used only when SPORTMONKS_API_TOKEN is blank.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LEAGUE_IDS=39,140,135,78,61,2
API_FOOTBALL_SEASON=

# Vercel cron protection
CRON_SECRET=

# Optional salt for hashed waitlist client IPs. Falls back to CRON_SECRET.
RATE_LIMIT_SALT=

# Resend SMTP (configure inside Supabase Auth -> SMTP, not used by the app)
RESEND_API_KEY=

# Observability
#
# Sentry: the DSN is safe to expose to the browser. Set NEXT_PUBLIC_SENTRY_DSN
# for client errors, and optionally SENTRY_DSN for server/edge errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_RELEASE=
# Only needed to upload source maps during a CI build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog: identify users by Supabase ID, never by email.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# The Odds API (optional additional football data provider)
#
# Credits: /sports and /events are free. /odds costs 1 per market per region.
# /scores costs 1, or 2 when daysFrom is used. The free plan is 500 credits per
# month; the current live/odds cron schedule needs a paid plan. The 20K plan
# ($30/month) requires slower cron intervals; the 100K plan ($59/month) covers
# the default 2-minute live and 10-minute odds schedule for one sport key.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# Comma-separated sport keys. Use specific keys such as soccer_epl,
# soccer_spain_la_liga, soccer_italy_serie_a. There is no generic "soccer" key.
THE_ODDS_API_SPORT_KEYS=soccer_epl
# Bookmaker regions. Every region multiplies the /odds credit cost.
THE_ODDS_API_REGIONS=eu
# Bulk /odds markets. Only h2h (1X2) and totals (O/U) are supported by the
# bulk endpoint. The Odds API's btts and double_chance markets are per-event
# add-ons and are intentionally not requested here to protect the credit budget.
THE_ODDS_API_MARKETS=h2h,totals

# ---------------------------------------------------------------------------
# BetApp local environment
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for Supabase email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings
# DATABASE_URL: use the transaction pooler (port 6543) for the app.
# DATABASE_URL_DIRECT: use the direct connection (port 5432) for drizzle-kit.
DATABASE_URL=
DATABASE_URL_DIRECT=

# One-time admin bootstrap (npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=BetApp Admin
ADMIN_DOB=1990-01-01

# API-Football (API-Sports)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Vercel cron protection
CRON_SECRET=

# Resend SMTP (configure inside Supabase Auth -> SMTP, not used by the app)
RESEND_API_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
